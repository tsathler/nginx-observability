{
  "id": null,
  "uid": "nginx-overview",
  "title": "Nginx | Overview",
  "description": "Traffic, reliability, latency, and cross-application comparison.",
  "tags": [
    "nginx",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/nginx-overview/overview",
      "icon": "external link",
      "tooltip": "Open Overview with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Application Detail",
      "type": "link",
      "url": "/d/nginx-application-detail/application-detail",
      "icon": "external link",
      "tooltip": "Open Application Detail with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Live Logs",
      "type": "link",
      "url": "/d/nginx-live-logs/live-logs",
      "icon": "external link",
      "tooltip": "Open Live Logs with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Security",
      "type": "link",
      "url": "/d/nginx-security/security",
      "icon": "external link",
      "tooltip": "Open Security with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nginx_http_response_count_total, app)",
          "refId": "Prometheus-app"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 13,
      "type": "stat",
      "title": "Service and collection health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Scrape state of each application health check and of the collection pipeline (nginx-health, nginx-access exporter, Alloy, Loki). DOWN means the metrics on this dashboard may be incomplete or stale; No samples means Prometheus itself is not answering.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_replace(up{job=\"app-health\"}, \"component\", \"$1\", \"app\", \"(.*)\") or label_replace(up{job=~\"nginx-health|nginx-access|alloy|loki\"}, \"component\", \"$1\", \"job\", \"(.*)\")",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No samples in selected range",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
    {
      "id": 14,
      "type": "alertlist",
      "title": "Active alerts",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 4
      },
      "description": "Grafana alert rules currently firing or pending. Empty means no rule is active.",
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 10,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "error": true,
          "normal": false
        }
      }
    },
