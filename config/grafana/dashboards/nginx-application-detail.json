      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10,max_over_time({job=\"nginx\",app=~\"$app\"} | method=~\"${method:regex}\" | status=~\"${status:raw}\" | path=~\".*${path:regex}.*\" | unwrap request_time | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Maximum observed request time per app, method, status, and path grouping in the selected range. Fields are structured metadata, not stream labels.",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "detected_level": true,
              "filename": true,
              "job": true,
              "service_name": true
            },
            "indexByName": {
              "Time": 0,
              "app": 1,
              "method": 2,
              "status": 3,
              "path": 4,
              "remote_addr": 5,
              "Value": 6
            },
            "renameByName": {
              "method": "Method",
              "status": "Status",
              "path": "Path",
              "remote_addr": "Source IP",
              "Value": "Max request time (s)"
            }
          }
        }
      ]
    },
