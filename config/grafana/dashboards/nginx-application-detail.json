      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(nginx_http_response_count_total{server=~\"$server\",app=~\"$app\",method=~\"${method:regex}\",status=~\"${status:raw}\"}[$__range]))",
          "refId": "A",
