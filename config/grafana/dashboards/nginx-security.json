          "editorMode": "code",
          "expr": "topk(10,sum by (remote_addr) (count_over_time({job=\"nginx\",app=~\"$app\"} | json | status=~\"4..|5..\" | remote_addr=~\"${source_ip:raw}\" [5m])))",
