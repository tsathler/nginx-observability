    {
      "id": 9,
      "title": "Common scanner-like paths (observed)",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (app,path) (count_over_time({job=\"nginx\",app=~\"$app\"} | json | path=~\".*(\\\\.env|\\\\.git|wp-admin|wp-login\\\\.php|phpmyadmin|/etc/passwd).*\" [5m]))",
          "queryType": "instant",
          "refId": "A",
          "legendFormat": "{{app}} {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      },
      "description": "Finite synthetic probes only; these paths indicate a pattern worth checking, not proof of malicious intent."
    },
    {
      "id": 10,
      "title": "Origins with repeated 4xx / 5xx",
      "type": "barchart",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
