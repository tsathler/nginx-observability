  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "query",
        "description": "Scopes HTTP metrics and Loki events to one simulated application or all applications.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nginx_http_response_count_total, app)",
          "refId": "Prometheus-app"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "source_ip",
        "label": "Source IP regex",
        "type": "textbox",
        "description": "RE2 regular expression for Loki origin and event queries only. IP stays in structured event metadata, not indexed labels.",
        "query": ".*",
        "current": {
          "selected": true,
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
