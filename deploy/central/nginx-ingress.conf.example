# Ingress for the Alloy agents, served by the Nginx already running on the central server.
# Copy to /etc/nginx/sites-available/observability-ingress, replace every <PLACEHOLDER>,
# enable it and reload:
#   sudo ln -s /etc/nginx/sites-available/observability-ingress /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# (A file in conf.d/ needs no link.) Prepare first: sudo apt install apache2-utils (htpasswd)
# and sudo install -d -m 0750 /etc/nginx/observability/tls for the certificate and key.
#
# Trust limit: a password proves the caller is one of the agents, not which one. The server
# label is set by the agent, so a compromised agent could send data as another server. Keep
# one password per server, the IP list short, and watch this ingress's access log.
#
# Only two paths are exposed, both write-only: Loki push and Prometheus remote_write.
# Query APIs, UIs and everything else stay on 127.0.0.1.

# Caps what one agent can push: an agent sends about one Loki batch per second and one
# remote_write every few seconds; a runaway or abused agent is held back with 429.
limit_req_zone $binary_remote_addr zone=observability_agents:1m rate=20r/s;

# Bind to the private interface only, on a dedicated port. Never to 0.0.0.0 on a host
# with a public interface.
server {
    listen <CENTRAL_PRIVATE_IP>:<INGRESS_PORT> ssl;
    server_name <CENTRAL_INTERNAL_NAME>;

    ssl_certificate     /etc/nginx/observability/tls/server.crt;
    ssl_certificate_key /etc/nginx/observability/tls/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # One line per monitored server (its private IP). Everything else is refused.
    allow <AGENT_IP_1>;
    # allow <AGENT_IP_2>;
    deny all;

    # One user per agent: sudo htpasswd -B /etc/nginx/observability/agents.htpasswd <server-name>
    auth_basic           "observability ingress";
    auth_basic_user_file /etc/nginx/observability/agents.htpasswd;

    server_tokens off;
    limit_req zone=observability_agents burst=100 nodelay;
    limit_req_status 429;
    client_max_body_size 10m;
    access_log /var/log/nginx/observability-ingress.access.log;
    error_log  /var/log/nginx/observability-ingress.error.log warn;

    location = /loki/api/v1/push {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:<LOKI_PORT>;
        proxy_set_header Authorization "";
    }

    location = /api/v1/write {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:<PROMETHEUS_PORT>;
        proxy_set_header Authorization "";
    }

    location / {
        return 404;
    }
}
