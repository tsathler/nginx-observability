{
  "id": null,
  "uid": "nginx-application-detail",
  "title": "Nginx | Application Detail",
  "description": "Application, Method, and Status filter metrics and logs. Path filters Loki panels only because paths are not Prometheus labels.",
  "tags": [
    "nginx",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/nginx-overview/overview",
      "icon": "external link",
      "tooltip": "Open Overview with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Application Detail",
      "type": "link",
      "url": "/d/nginx-application-detail/application-detail",
      "icon": "external link",
      "tooltip": "Open Application Detail with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Live Logs",
      "type": "link",
      "url": "/d/nginx-live-logs/live-logs",
      "icon": "external link",
      "tooltip": "Open Live Logs with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Security",
      "type": "link",
      "url": "/d/nginx-security/security",
      "icon": "external link",
      "tooltip": "Open Security with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "description": "Monitored host that produced the metrics and events. All includes data recorded before the server label existed.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nginx_http_response_count_total, server)",
          "refId": "Prometheus-server"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "app",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nginx_http_response_count_total{server=~\"$server\"}, app)",
          "refId": "Prometheus-app"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "method",
        "label": "Method",
        "type": "custom",
        "query": "GET,POST",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "GET",
            "value": "GET"
          },
          {
            "selected": false,
            "text": "POST",
            "value": "POST"
          }
        ]
      },
      {
        "name": "status",
        "label": "Status class / code",
        "type": "custom",
        "query": "2xx : 2..,3xx : 3..,4xx : 4..,5xx : 5..,403,404,429,500",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "2xx",
            "value": "2.."
          },
          {
            "selected": false,
            "text": "3xx",
            "value": "3.."
          },
          {
            "selected": false,
            "text": "4xx",
            "value": "4.."
          },
          {
            "selected": false,
            "text": "5xx",
            "value": "5.."
          },
          {
            "selected": false,
            "text": "403",
            "value": "403"
          },
          {
            "selected": false,
            "text": "404",
            "value": "404"
          },
          {
            "selected": false,
            "text": "429",
            "value": "429"
          },
          {
            "selected": false,
            "text": "500",
            "value": "500"
          }
        ]
      },
      {
        "name": "path",
        "label": "Path contains (Loki only)",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(nginx_http_response_count_total{server=~\"$server\",app=~\"$app\",method=~\"${method:regex}\",status=~\"${status:raw}\"}[$__rate_interval]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [],
          "unit": "reqps",
          "noValue": "No samples in selected range",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value"
      }
    },
    {
