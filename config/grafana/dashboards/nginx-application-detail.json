      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10,sum by (path) (count_over_time({job=\"nginx\",app=~\"$app\"} | method=~\"${method:regex}\" | status=~\"${status:raw}\" | path=~\".*${path:regex}.*\" [$__range])))",
