          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(nginx_http_response_count_total{server=~\"$server\",app=~\"$app\",method=~\"${method:regex}\",status=~\"${status:raw}\",status=~\"4..|5..\"}[$__rate_interval]))",
