{
  "id": null,
  "uid": "nginx-application-detail",
  "title": "Nginx | Application Detail",
  "description": "Compare and investigate one or all applications without per-app panels.",
  "tags": [
    "nginx",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/nginx-overview/overview",
      "icon": "external link",
      "tooltip": "Open Overview with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Application Detail",
      "type": "link",
      "url": "/d/nginx-application-detail/application-detail",
      "icon": "external link",
      "tooltip": "Open Application Detail with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Live Logs",
      "type": "link",
      "url": "/d/nginx-live-logs/live-logs",
      "icon": "external link",
      "tooltip": "Open Live Logs with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Security",
      "type": "link",
      "url": "/d/nginx-security/security",
      "icon": "external link",
      "tooltip": "Open Security with the current app and time range",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nginx_http_response_count_total, app)",
          "refId": "Prometheus-app"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "method",
        "label": "Method",
        "type": "custom",
        "query": "GET,POST",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "GET",
            "value": "GET"
          },
          {
            "selected": false,
            "text": "POST",
            "value": "POST"
          }
        ]
      },
      {
        "name": "status",
        "label": "Status class / code",
        "type": "custom",
        "query": "2xx : 2..,3xx : 3..,4xx : 4..,5xx : 5..,403,404,429,500",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "2xx",
            "value": "2.."
          },
          {
            "selected": false,
            "text": "3xx",
            "value": "3.."
          },
          {
            "selected": false,
            "text": "4xx",
            "value": "4.."
          },
          {
            "selected": false,
            "text": "5xx",
            "value": "5.."
          },
          {
            "selected": false,
            "text": "403",
            "value": "403"
          },
          {
            "selected": false,
            "text": "404",
            "value": "404"
          },
          {
            "selected": false,
            "text": "429",
            "value": "429"
          },
          {
            "selected": false,
            "text": "500",
            "value": "500"
          }
        ]
      },
      {
        "name": "path",
        "label": "Path contains",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(nginx_http_response_count_total{app=~\"$app\",method=~\"${method:regex}\",status=~\"${status:raw}\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "reqps",
          "noValue": "No samples in selected range",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
