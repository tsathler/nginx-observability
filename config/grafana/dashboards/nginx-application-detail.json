    {
      "id": 10,
      "title": "Most requested paths (event count)",
      "type": "barchart",
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10,sum by (path) (count_over_time({job=\"nginx\",server=~\"$server\",app=~\"$app\"} | json | __error__=\"\" | method=~\"${method:regex}\" | status=~\"${status:raw}\" | path=~`.*${path:regex}.*` [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "none",
          "decimals": 0
        },
