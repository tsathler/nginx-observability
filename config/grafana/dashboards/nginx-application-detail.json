          "editorMode": "code",
          "expr": "sum by (status) (rate(nginx_http_response_count_total{server=~\"$server\",app=~\"$app\",method=~\"${method:regex}\",status=~\"${status:raw}\"}[$__rate_interval]))",
          "refId": "A",
