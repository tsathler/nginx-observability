{
  "id": null,
  "uid": "nginx-live-logs",
  "title": "Nginx | Live Logs",
  "description": "Filter recent HTTP access events; use Grafana Explore Live for websocket tailing.",
  "tags": [
    "nginx",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
