# Copy to .env on the central server and edit there. Never commit the real .env.

# Dedicated volume for observability data (keeps Loki from filling the system disk).
# Create before the first start:
#   sudo mkdir -p $DATA_DIR/loki $DATA_DIR/prometheus
#   sudo chown 10001:10001 $DATA_DIR/loki          # Loki runs as uid 10001
#   sudo chown 65534:65534 $DATA_DIR/prometheus    # Prometheus runs as nobody
DATA_DIR=/srv/observability

# Loopback ports the host Nginx ingress proxies to (not reachable from other machines).
LOKI_PORT=13100
PROMETHEUS_PORT=19090

# Retention. Personal data (client IPs) lives in Loki: agree the period with the data owner.
LOKI_RETENTION_PERIOD=168h
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB

# Docker network the existing Grafana container joins to read Loki and Prometheus.
CENTRAL_NETWORK=nginx-observability-central
