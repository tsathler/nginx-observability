    {
      "id": 6,
      "title": "5xx share (current)",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "refId": "A",
          "instant": true,
          "expr": "(sum (rate(nginx_http_response_count_total{server=~\"$server\",app=~\"$app\",method=~\"${method:regex}\",status=~\"5..\"}[$__rate_interval])) or (0 * sum (rate(nginx_http_response_count_total{server=~\"$server\",app=~\"$app\",method=~\"${method:regex}\"}[$__rate_interval])))) / sum (rate(nginx_http_response_count_total{server=~\"$server\",app=~\"$app\",method=~\"${method:regex}\"}[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
