    {
      "id": 9,
      "title": "Methods (estimated period total)",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
