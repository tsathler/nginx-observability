        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "enablePagination": true
        }
      },
      "description": "Structured columns support quick scanning; Raw event preserves the original JSON line. Filters apply to app, method, status, and path.",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "tsNs": true,
              "labelTypes": true,
              "id": true
            },
            "indexByName": {
              "Time": 0,
              "app": 1,
              "method": 2,
              "status": 3,
              "path": 4,
              "request_time": 5,
              "remote_addr": 6,
              "Line": 7
            },
            "renameByName": {
              "method": "Method",
              "status": "Status",
              "path": "Path",
              "request_time": "Duration (s)",
              "remote_addr": "Source IP",
              "Line": "Raw event"
            }
          }
        }
      ]
    }
