# Copy to .env on the monitored server and edit there. Never commit the real .env.

# Name shown in the dashboards' Server variable and in alerts. Short, lowercase, unique.
AGENT_SERVER_NAME=web-01

# Central ingress (host Nginx with TLS), without a trailing slash.
CENTRAL_URL=https://observability.internal.example:8443

# This agent's password in the central agents.htpasswd (user = AGENT_SERVER_NAME).
AGENT_PASSWORD=

# CA certificate that signed the central ingress certificate (PEM).
CENTRAL_CA_FILE=/etc/observability/central-ca.pem

# Directory with the sanitized JSON logs, one file per application: <app>.json.
NGINX_JSON_LOG_DIR=/var/log/nginx/observability
