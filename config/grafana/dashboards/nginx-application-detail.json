      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        },
        "xField": "path"
      },
      "description": "Exact Loki event count in the selected period. Top 10 paths, ordered by request volume; app, method, status, and path filters apply. Path is structured metadata, not an indexed stream label.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Slowest by app/method/status/path",
      "type": "table",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10,1000 * max by (server,app,method,status,path) (max_over_time({job=\"nginx\",server=~\"$server\",app=~\"$app\"} | json | __error__=\"\" | method=~\"${method:regex}\" | status=~\"${status:raw}\" | path=~`.*${path:regex}.*` | unwrap request_time | __error__=\"\" [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "legendFormat": "{{server}} / {{app}} / {{method}} / {{status}} / {{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Max duration (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Max duration (ms)",
            "desc": true
          }
        ]
      },
      "description": "Maximum request time in milliseconds for each app, method, status, and path group within the selected range. Results are limited to the top 10 and sorted by duration descending.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "app": 1,
              "method": 2,
              "status": 3,
