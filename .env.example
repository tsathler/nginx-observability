NGINX_PORT=8080
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
REQUESTS_PER_SECOND=2
GRAFANA_ADMIN_USER=admin
# Generate a local password with: python scripts/init_lab_env.py
GRAFANA_ADMIN_PASSWORD=
# Prometheus removes TSDB blocks when either limit is reached; size excludes some WAL/head overhead.
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=1GB
# Loki time retention requires at least 24h; expiration is asynchronous through the Compactor.
LOKI_RETENTION_PERIOD=168h
# Host-side scripts/rotate_logs.py checks the six Nginx access files against this threshold.
NGINX_LOG_ROTATE_BYTES=16777216
NGINX_LOG_ROTATE_KEEP=3
